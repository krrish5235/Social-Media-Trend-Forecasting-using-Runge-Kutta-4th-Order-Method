# Copy to .env and fill in. Never commit .env.

# Get a key: https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> Credentials -> API key
# Leave empty to run in demo mode with synthetic data.
YOUTUBE_API_KEY=

# auto = live if a key is set, otherwise demo. Or force: live | demo
DATA_MODE=auto

DB_PATH=data/snapshots.db
CACHE_TTL_SECONDS=900
MAX_PEERS=50
SHORTS_MAX_SECONDS=180
RATE_LIMIT_PER_MIN=30
N_DRAWS=400

# Set to 1 when running behind a reverse proxy (nginx, Render, Fly, Railway...)
TRUST_PROXY=0
